<Project Sdk="Microsoft.NET.Sdk">

  <!-- M5-04: ExportSample — minimal game for the one-click exporter. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ExportSample</RootNamespace>
    <AssemblyName>ExportSample</AssemblyName>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\managed\Engine.Bindings\Engine.Bindings.csproj" />
    <ProjectReference Include="..\..\managed\Engine.Runtime\Engine.Runtime.csproj" />
    <ProjectReference Include="..\..\managed\Engine.Systems\Engine.Systems.csproj" />
  </ItemGroup>

</Project>
