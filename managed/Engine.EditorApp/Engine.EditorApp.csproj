<Project Sdk="Microsoft.NET.Sdk">

  <!-- P3-01: Avalonia editor app shell (engine-editor executable). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Engine.EditorApp</RootNamespace>
    <AssemblyName>engine-editor</AssemblyName>
    <Description>engine-editor: Avalonia editor app shell (P3-01).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engine.Editor\Engine.Editor.csproj" />
  </ItemGroup>

  <!-- M2-03: ENG0002 runs over component definitions (dogfood). -->
  <ItemGroup>
    <ProjectReference Include="..\Engine.Analyzers\Engine.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
