<Project Sdk="Microsoft.NET.Sdk">

  <!-- M5-03: standalone engine-cli control-plane client (Unix socket NDJSON). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Engine.Cli</RootNamespace>
    <AssemblyName>engine-cli</AssemblyName>
    <Description>engine-cli: JSON-RPC control plane for the Editor CliServer (M5-03).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engine.Editor\Engine.Editor.csproj" />
  </ItemGroup>

  <!-- M2-03: ENG0002 runs over component definitions (dogfood). -->
  <ItemGroup>
    <ProjectReference Include="..\Engine.Analyzers\Engine.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
