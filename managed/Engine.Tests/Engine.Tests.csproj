<Project Sdk="Microsoft.NET.Sdk">

  <!-- M1-01 harness: runs placeholder checks as a console gate. -->
  <!-- M2/M1-04 replace the checks with real layout assertions + Benchmark1M. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Engine.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engine.Bindings\Engine.Bindings.csproj" />
    <ProjectReference Include="..\Engine.Runtime\Engine.Runtime.csproj" />
  </ItemGroup>

  <!-- M2-03: analyzer gates run the REAL analyzers over in-memory
       fixtures. CSharp + Workspaces give the Compilation/AnalyzerDriver
       hosts and the AdhocWorkspace for the codefix check; the analyzer
       and codefix assemblies load BY PATH at runtime (FindBin) — never
       as compile references, so their MEF/Composition closures never
       collide with the Workspaces closure (MSB3277-proof).
       PrivateAssets=all: compile-only, never published with the runner.
       Build-only project refs (no compile closure): building/running
       Engine.Tests directly still produces the analyzer + codefix DLLs
       FindBin loads — without them LoadFrom throws FileNotFoundException.
       M2-04: Microsoft.CodeAnalysis.CSharp (same version) also serves
       HotReloadTests fixture compilation (in-memory emit to byte[]). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.13.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.13.0" PrivateAssets="all" />
    <ProjectReference Include="..\Engine.Analyzers\Engine.Analyzers.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Engine.CodeFixes\Engine.CodeFixes.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
