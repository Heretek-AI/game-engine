<Project Sdk="Microsoft.NET.Sdk">

  <!-- M1-01 placeholder: real zero-copy P/Invoke tables are generated by -->
  <!-- tools/abi_codegen in M1-04 (NativeApi.g.cs). This keeps `dotnet build` -->
  <!-- green from day one; M1-04 replaces the stub with generated bindings. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TieredPGO>true</TieredPGO>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Engine.Bindings</RootNamespace>
    <AssemblyName>Engine.Bindings</AssemblyName>
    <Description>Auto-generated zero-copy P/Invoke tables (M1-04 owner).</Description>
  </PropertyGroup>

</Project>
