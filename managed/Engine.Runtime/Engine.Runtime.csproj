<Project Sdk="Microsoft.NET.Sdk">

  <!-- M1-01 placeholder: stateless runtime host (Query<T>, Time, ALC) is -->
  <!-- M1-05 (hostfxr) + M2 (Illusion compiler) owner. Builds green today. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TieredPGO>true</TieredPGO>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Engine.Runtime</RootNamespace>
    <AssemblyName>Engine.Runtime</AssemblyName>
    <Description>Stateless .NET logic runner over native memory (M1-05/M2 owner).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engine.Bindings\Engine.Bindings.csproj" />
  </ItemGroup>

  <!-- M2-03: ENG0002 runs over component definitions (dogfood). -->
  <ItemGroup>
    <ProjectReference Include="..\Engine.Analyzers\Engine.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
