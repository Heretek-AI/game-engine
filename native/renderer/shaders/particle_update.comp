// particle_update.comp — P5-05: fixed-step Euler integrate + age.
//
// One invocation per live particle (256 threads/group, dispatch sized to
// capacity; ids >= counters.alive exit). Mirrors ParticleSimulateCpu step
// 1: age += dt, and only particles still alive (age < life) integrate
// (vel.y += gravity*dt, pos += vel*dt). Dead ones are removed by
// particle_compact.comp right after, so slots[0, alive) stays packed.
//
// GLSL 460 + GL_EXT_scalar_block_layout. Offline SPIR-V via
// glslangValidator (vulkan1.3), embedded with embed_spv.py.
#version 460
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 256) in;

struct Particle {
  vec3 pos;
  vec3 vel;
  float age;
  float life;
  float size0;
  float seed;
  vec4 color0;
  float pad;
};

layout(set = 0, binding = 0, scalar) buffer SlotsBuf {
  Particle slots[];
};

// Shared ParticleGpuSim interface (all three sim shaders):
//   set 0 binding 0: slots[capacity] (Particle, 60 B scalar)
//   set 0 binding 1: ParticleSystem params (76 B)
//   set 0 binding 2: counters {alive, spawned_total, last_spawned, pad}
//   push (20 B): dt, gravity, spawn_request, capacity, mode
layout(set = 0, binding = 2, scalar) buffer CountersBuf {
  uint alive;
  uint spawned_total;
  uint last_spawned;
  uint pad;
} g_counters;

layout(push_constant, scalar) uniform SimPush {
  float dt;
  float gravity;
  uint spawn_request;  // host spawn budget for this step (rate + bursts)
  uint capacity;
  uint mode;           // particle_compact.comp: 0 compact, 1 finalize
} g_push;

void main() {
  uint id = gl_GlobalInvocationID.x;
  if (id >= g_counters.alive) {
    return;
  }
  Particle p = slots[id];
  p.age += g_push.dt;
  if (p.age < p.life) {
    p.vel.y += g_push.gravity * g_push.dt;
    p.pos += p.vel * g_push.dt;
  }
  slots[id] = p;
}
