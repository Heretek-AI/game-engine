// equirect_to_cube.comp — P4-05: equirect HDR -> cubemap face conversion.
//
// One invocation per cubemap texel (face = gl_WorkGroupID.z mapped from
// the dispatch z dimension, or the push-constant face for drivers that
// need it — here z-dispatch: dispatch (size/16, size/16, 6)).
// Reads the float equirect (set 0 binding 0, R32G32B32A32_SFLOAT sampled)
// with a CLAMP_TO_EDGE linear sampler; writes one RGBA32F texel into the
// cubemap layer (set 0 binding 1, rgba32f storage image, layer selected
// by gl_GlobalInvocationID.z).
//
// Direction math mirrors SkyboxFaceDir() in
// skybox_image_based_lighting.hpp term for term (+Y up, +X/-X/+Y/-Y/+Z/-Z
// layer order, (u,v) in [-1,1] from texel centers, texel x right / y
// down). Sky zenith lands at the middle of the equirect's top row.
// Linear HDR throughout: no sRGB anywhere (the P4-02 post pass tonemaps
// at frame time).
//
// GLSL 460. Offline SPIR-V via glslangValidator (vulkan1.3), embedded
// with embed_spv.py into equirect_to_cube_spv.inc (both shader dirs).
#version 460
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D u_equirect;

layout(set = 0, binding = 1, rgba32f) uniform writeonly image2DArray u_cube;

layout(push_constant, scalar) uniform CubePush {
  uint face_size;  // cubemap edge in texels (dispatch x/y cover it)
} g_push;

vec3 face_dir(uint face, uint x, uint y, uint size) {
  float u = (float(x) + 0.5) / float(size) * 2.0 - 1.0;
  float v = (float(y) + 0.5) / float(size) * 2.0 - 1.0;
  vec3 d = vec3(0.0, 0.0, 0.0);
  switch (face) {
    case 0: d = vec3(1.0, -v, -u); break;   // +X
    case 1: d = vec3(-1.0, -v, u); break;   // -X
    case 2: d = vec3(u, 1.0, v); break;     // +Y
    case 3: d = vec3(u, -1.0, -v); break;   // -Y
    case 4: d = vec3(u, -v, 1.0); break;    // +Z
    default: d = vec3(-u, -v, -1.0); break; // -Z
  }
  return normalize(d);
}

void main() {
  uint face = gl_GlobalInvocationID.z;
  uint x = gl_GlobalInvocationID.x;
  uint y = gl_GlobalInvocationID.y;
  if (face >= 6u || x >= g_push.face_size || y >= g_push.face_size) {
    return;
  }
  vec3 d = face_dir(face, x, y, g_push.face_size);
  // Direction -> equirect UV (mirrors SkyboxDirToUv term for term:
  // u = 0.5 + atan(x, z)/2pi wrapped, v = acos(clamp(y))/pi).
  float u = 0.5 + atan(d.x, d.z) / 6.283185307179586;
  u = fract(u);
  float v = acos(clamp(d.y, -1.0, 1.0)) / 3.141592653589793;
  vec4 hdr = texture(u_equirect, vec2(u, v));
  imageStore(u_cube, ivec3(int(x), int(y), int(face)),
             vec4(hdr.rgb, 1.0));
}
